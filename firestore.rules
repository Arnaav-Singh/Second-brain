rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Projects collection
    match /projects/{projectId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Actions collection
    match /actions/{actionId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Tasks collection
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Timetable slots collection
    match /timetable_slots/{slotId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Study sessions collection
    match /study_sessions/{sessionId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Study settings collection (document ID = userId)
    match /study_settings/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Fitness settings collection (document ID = userId)
    match /fitness_settings/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Weekly reviews collection
    match /weekly_reviews/{reviewId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Weekly study reports collection
    match /weekly_study_reports/{reportId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      // Only Cloud Functions can write reports
    }
    
    // Energy days collection
    match /energy_days/{dayId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Email logs collection
    match /email_logs/{logId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      // Only Cloud Functions can write logs
    }

    // Daily Summaries collection
    match /daily_summaries/{summaryId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
  }
}
